{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.local/schemas/far-epistemic-v1.schema.json",
  "title": "FAR epistemic learning document",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "far_ir_version",
    "evidence",
    "elenchus_sessions",
    "snapshots",
    "records",
    "metadata"
  ],
  "properties": {
    "format_version": {
      "const": "far-epistemic/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "far_ir_version": {
      "enum": [
        "far-ir/1.0",
        "far-ir/2.0",
        "far-ir/2.1"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "observed_at",
          "statement",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "required": [
              "evidence_id",
              "source_uri",
              "artifact_sha256",
              "byte_target"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "source_uri": {
                "type": "string",
                "minLength": 1
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "byte_target": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "elenchus_sessions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "captured_at",
          "belief_ref",
          "belief_revision_ref",
          "evidence_refs",
          "hypothesis_probabilities",
          "canonicalization",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "belief_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "belief_revision_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "uniqueItems": true
          },
          "hypothesis_probabilities": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^(0\\.[0-9]{6}|1\\.000000)$"
            },
            "minProperties": 2
          },
          "canonicalization": {
            "const": "FAR-CJ/1"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "provenance",
              "hypotheses",
              "revisions",
              "current_revision_ref"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "kind": {
                "const": "belief"
              },
              "provenance": {
                "type": "object",
                "required": [
                  "source_uri",
                  "artifact_sha256",
                  "far_refs",
                  "evidence_refs",
                  "elenchus_session_refs"
                ],
                "properties": {
                  "source_uri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artifact_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "far_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                    },
                    "uniqueItems": true
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                    },
                    "uniqueItems": true
                  },
                  "elenchus_session_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              "hypotheses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "statement",
                    "prior_probability",
                    "base_reference_classes",
                    "falsifiers",
                    "uncertainty"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prior_probability": {
                      "type": "string",
                      "pattern": "^(0\\.[0-9]{6}|1\\.000000)$"
                    },
                    "base_reference_classes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "falsifiers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "uncertainty": {
                      "type": "object",
                      "required": [
                        "kind",
                        "description"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "ALEATORY",
                            "EPISTEMIC",
                            "MIXED",
                            "UNKNOWN"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 2
              },
              "revisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "timestamp",
                    "supersedes",
                    "trigger_outcome_ref",
                    "probabilities",
                    "evidence_refs",
                    "update_rule",
                    "rationale"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                    },
                    "supersedes": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "trigger_outcome_ref": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "probabilities": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^(0\\.[0-9]{6}|1\\.000000)$"
                      },
                      "minProperties": 2
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                      },
                      "uniqueItems": true
                    },
                    "update_rule": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "current_revision_ref": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "causal_model_ref": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "provenance",
              "belief_ref",
              "belief_snapshot_ref",
              "hypothesis_ref",
