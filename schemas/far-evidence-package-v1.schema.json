{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.invalid/schemas/far-evidence-package-v1.schema.json",
  "title": "FAR Evidence Package v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "subject_id", "claims", "boundaries"],
  "properties": {
    "schema": {"const": "far-evidence-package/1.0"},
    "package_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "boundaries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "status", "support", "assumptions", "contradicts", "boundaries"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["observed", "derived", "inferred", "declared", "unknown", "contradicted", "unverifiable"]
          },
          "support": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "contradicts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "boundaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
