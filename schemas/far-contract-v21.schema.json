{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.local/schemas/far-contract-v21.schema.json",
  "title": "Project FAR approximation-and-cost envelope",
  "description": "Additive far-ir/2.1 envelope over an unchanged valid far-ir/2.0 record. Operational semantics are finite-explicit and declaration-relative; no universal metric, loss, aggregation, tolerance, or scalar cost is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version","id","base_v2","approximation_semantics","cost_semantics","report","provenance"],
  "properties": {
    "format_version": {"const":"far-ir/2.1"},
    "id": {"$ref":"#/$defs/Identifier"},
    "base_v2": {"type":"object"},
    "approximation_semantics": {"$ref":"#/$defs/ApproximationSemantics"},
    "cost_semantics": {"$ref":"#/$defs/CostSemantics"},
    "report": {"$ref":"#/$defs/Report"},
    "provenance": {"$ref":"#/$defs/Provenance"},
    "extensions": {"$ref":"#/$defs/Extensions"}
  },
  "$defs": {
    "Identifier": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "NonEmptyText": {"type":"string","minLength":1},
    "Rational": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"},
    "Extensions": {"type":"object","propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_.:-]*$"},"additionalProperties":true},
    "PairLoss": {"type":"object","additionalProperties":false,"required":["left","right","value"],"properties":{"left":{},"right":{},"value":{"$ref":"#/$defs/Rational"}}},
    "Discrepancy": {"type":"object","additionalProperties":false,"required":["id","kind","separating"],"properties":{"id":{"$ref":"#/$defs/Identifier"},"kind":{"enum":["zero_one","finite_table"]},"separating":{"type":"boolean"},"metric_declared":{"type":"boolean"},"table":{"type":"array","items":{"$ref":"#/$defs/PairLoss"}},"notes":{"type":"string"}}},
    "ReferenceWeight": {"type":"object","additionalProperties":false,"required":["case_id","weight"],"properties":{"case_id":{"$ref":"#/$defs/Identifier"},"weight":{"$ref":"#/$defs/Rational"}}},
    "Aggregation": {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["pointwise","worst_case","expected","vector"]},"reference_measure":{"type":"array","items":{"$ref":"#/$defs/ReferenceWeight"}},"notes":{"type":"string"}}},
    "Tolerance": {"type":"object","additionalProperties":false,"required":["relation","threshold"],"properties":{"relation":{"const":"le"},"threshold":{"oneOf":[{"$ref":"#/$defs/Rational"},{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Rational"}}]},"notes":{"type":"string"}}},
    "Sample": {"type":"object","additionalProperties":false,"required":["case_id","target","achieved"],"properties":{"case_id":{"$ref":"#/$defs/Identifier"},"target":{},"achieved":{}}},
    "RandomizedKernelEntry": {"type":"object","additionalProperties":false,"required":["input","output_distribution"],"properties":{"input":{},"output_distribution":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["value","probability"],"properties":{"value":{},"probability":{"$ref":"#/$defs/Rational"}}}}}},
    "DecoderClass": {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["deterministic","randomized","both"]},"randomized_kernel":{"type":"array","items":{"$ref":"#/$defs/RandomizedKernelEntry"}},"notes":{"type":"string"}}},
    "ApproximationSemantics": {"type":"object","additionalProperties":false,"required":["status","scope","discrepancy","aggregation","tolerance","decoder_class","samples","claims_exact_at_zero"],"properties":{"status":{"const":"OPERATIONAL_FINITE_EXPLICIT"},"scope":{"const":"finite_explicit"},"discrepancy":{"$ref":"#/$defs/Discrepancy"},"aggregation":{"$ref":"#/$defs/Aggregation"},"tolerance":{"$ref":"#/$defs/Tolerance"},"decoder_class":{"$ref":"#/$defs/DecoderClass"},"samples":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Sample"}},"claims_exact_at_zero":{"type":"boolean"},"notes":{"type":"string"}}},
    "CostCoordinate": {"type":"object","additionalProperties":false,"required":["id","value","unit","direction"],"properties":{"id":{"$ref":"#/$defs/Identifier"},"value":{"$ref":"#/$defs/Rational"},"unit":{"$ref":"#/$defs/NonEmptyText"},"direction":{"enum":["min","max"]}}},
    "Candidate": {"type":"object","additionalProperties":false,"required":["id","coordinates"],"properties":{"id":{"$ref":"#/$defs/Identifier"},"coordinates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/CostCoordinate"}}}},
    "ExplicitRelation": {"type":"object","additionalProperties":false,"required":["better_or_equal","worse_or_equal"],"properties":{"better_or_equal":{"$ref":"#/$defs/Identifier"},"worse_or_equal":{"$ref":"#/$defs/Identifier"}}},
    "Comparison": {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["componentwise","explicit_preorder"]},"relations":{"type":"array","items":{"$ref":"#/$defs/ExplicitRelation"}},"notes":{"type":"string"}}},
    "ScalarWeight": {"type":"object","additionalProperties":false,"required":["coordinate_id","weight"],"properties":{"coordinate_id":{"$ref":"#/$defs/Identifier"},"weight":{"$ref":"#/$defs/Rational"}}},
    "Scalarization": {"type":"object","additionalProperties":false,"required":["status","weights"],"properties":{"status":{"const":"EXPLICIT_PREFERENCE"},"weights":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ScalarWeight"}},"notes":{"type":"string"}}},
    "CostSemantics": {"type":"object","additionalProperties":false,"required":["status","candidate_scope","candidates","comparison"],"properties":{"status":{"const":"OPERATIONAL_FINITE_CANDIDATE_SET"},"candidate_scope":{"$ref":"#/$defs/NonEmptyText"},"candidates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Candidate"}},"comparison":{"$ref":"#/$defs/Comparison"},"scalarization":{"$ref":"#/$defs/Scalarization"},"notes":{"type":"string"}}},
    "ApproximationReport": {"type":"object","additionalProperties":false,"required":["per_case_loss","achieved","within_tolerance","exactness_certified"],"properties":{"per_case_loss":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Rational"}},"achieved":{"oneOf":[{"$ref":"#/$defs/Rational"},{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Rational"}}]},"within_tolerance":{"type":"boolean"},"exactness_certified":{"type":"boolean"}}},
    "CostReport": {"type":"object","additionalProperties":false,"required":["minimal_candidate_ids","least_candidate_ids","unique_least_candidate_id"],"properties":{"minimal_candidate_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Identifier"}},"least_candidate_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Identifier"}},"unique_least_candidate_id":{"type":["string","null"]},"scalarized_selected_candidate_id":{"type":["string","null"]}}},
    "Report": {"type":"object","additionalProperties":false,"required":["approximation","cost","failure_report"],"properties":{"approximation":{"$ref":"#/$defs/ApproximationReport"},"cost":{"$ref":"#/$defs/CostReport"},"failure_report":{"type":"array","items":{"$ref":"#/$defs/NonEmptyText"}}}},
    "SourceHash": {"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/NonEmptyText"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "Provenance": {"type":"object","additionalProperties":false,"required":["producer","created_at","base_v2_git_blob_sha1","sources"],"properties":{"producer":{"$ref":"#/$defs/NonEmptyText"},"created_at":{"type":"string","format":"date-time"},"base_v2_git_blob_sha1":{"const":"e424359f804d268210e0f65fdf2fd28efc7e616b"},"sources":{"type":"array","items":{"$ref":"#/$defs/SourceHash"}},"notes":{"type":"string"}}}
  }
}
