{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.local/schemas/far-opportunity-registry-v1.schema.json",
  "title": "Project FAR Opportunity Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "authority", "opportunities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"const": "FAR-OPPORTUNITY-REGISTRY-1.0"},
    "authority": {"const": "canonical_planning_only_not_theory_authority"},
    "opportunities": {
      "type": "array",
      "items": {"$ref": "#/$defs/opportunity"}
    }
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "origin_provenance", "canonical", "status", "value_hypothesis", "theoretical_dependencies", "implementation_dependencies", "target_workstream", "priority", "epistemic_risk", "technical_risk", "commercial_hypothesis", "falsifier_test", "disposition", "related_artifacts_issues_prs"],
      "properties": {
        "id": {"type": "string", "pattern": "^OPP-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "origin_provenance": {"$ref": "#/$defs/stringArray"},
        "canonical": {"type": "boolean"},
        "status": {"enum": ["CAPTURED", "EVALUATING", "READY", "ACTIVE", "DEFERRED", "SUPERSEDED", "REJECTED"]},
        "value_hypothesis": {"type": "string", "minLength": 1},
        "theoretical_dependencies": {"$ref": "#/$defs/stringArray"},
        "implementation_dependencies": {"$ref": "#/$defs/stringArray"},
        "target_workstream": {"type": "string", "minLength": 1},
        "priority": {"enum": ["critical", "high", "medium", "low", "prohibited"]},
        "epistemic_risk": {"enum": ["low", "medium", "high", "prohibited"]},
        "technical_risk": {"enum": ["low", "medium", "high", "prohibited"]},
        "commercial_hypothesis": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "falsifier_test": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1},
        "related_artifacts_issues_prs": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
