{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-far.invalid/schemas/far-abstention-v1.schema.json",
  "title": "FAR Abstention v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_id",
    "reason",
    "blocking_dimensions",
    "reopen_conditions",
    "rationale"
  ],
  "properties": {
    "schema": {
      "const": "far-abstention/1.0"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "enum": [
        "insufficient_evidence",
        "insufficient_search_coverage",
        "ambiguous_interpretation",
        "unsupported_domain",
        "source_inaccessible",
        "provenance_failure",
        "conflicting_prerequisites",
        "security_boundary",
        "other"
      ]
    },
    "blocking_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source_integrity",
          "interpretation_fidelity",
          "search_coverage",
          "evidence_sufficiency",
          "inference_validity",
          "domain_support",
          "provenance",
          "security",
          "other"
        ]
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "support": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reopen_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "coverage_target": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "observed_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "claim_boundary": {
      "const": "Abstention records non-adjudication; it is not evidence for or against the target claim."
    }
  }
}
