      "canonical_prose_statement": "the observational quotient is the unique least-informative exact representation up to isomorphism",
      "quantified_objects_types": [
        "X : Type u cases",
        "B : Type v behavior values",
        "beta : X -> B",
        "rho : X -> R",
        "Q_beta := Quotient of beta equality",
