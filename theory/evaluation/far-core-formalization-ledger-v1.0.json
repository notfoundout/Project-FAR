      "canonical_prose_statement": "exact sufficiency iff behavior factors through the representation",
      "quantified_objects_types": [
        "X : Type u cases",
        "B : Type v complete exact behavior values",
        "R : Type w representation carrier",
        "beta : X -> B",
        "rho : X -> R",
        "decoder : RepImage rho -> B"
