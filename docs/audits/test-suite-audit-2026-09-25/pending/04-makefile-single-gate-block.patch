diff --git a/tools/makefile_gates.py b/tools/makefile_gates.py
new file mode 100644
index 0000000..8fbf382
--- /dev/null
+++ b/tools/makefile_gates.py
@@ -0,0 +1,31 @@
+"""Read the shared research-gate command block that the Makefile health targets run.
+
+The Makefile once repeated 35 gate commands in `health`, `health-fast`, and `research-check`,
+and nine checkers required each command to appear exactly three times. The commands now live
+once in `define research-gates`; this module lets those checkers require the stronger fact
+that every gate target runs the shared block and the block contains their command.
+"""
+from __future__ import annotations
+
+import re
+
+GATE_TARGETS = ("health", "health-fast", "research-check")
+BLOCK = re.compile(r"^define research-gates\n(.*?)^endef$", re.M | re.S)
+
+
+def gate_commands(makefile: str) -> list[str]:
+    match = BLOCK.search(makefile)
+    if not match:
+        return []
+    return [line.strip() for line in match.group(1).splitlines() if line.strip()]
+
+
+def target_recipe(makefile: str, target: str) -> list[str]:
+    match = re.search(rf"^{re.escape(target)}:[^\n]*\n((?:\t[^\n]*\n)*)", makefile, re.M)
+    return [line.strip() for line in match.group(1).splitlines()] if match else []
+
+
+def runs_in_every_gate_target(makefile: str, command: str) -> bool:
+    return command in gate_commands(makefile) and all(
+        "$(research-gates)" in target_recipe(makefile, target) for target in GATE_TARGETS
+    )
