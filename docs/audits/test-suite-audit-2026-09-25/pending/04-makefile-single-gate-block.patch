diff --git a/tests/test_makefile_gates.py b/tests/test_makefile_gates.py
new file mode 100644
index 0000000..04e43cc
--- /dev/null
+++ b/tests/test_makefile_gates.py
@@ -0,0 +1,49 @@
+import shutil
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "tools"))
+
+import makefile_gates as gates  # noqa: E402
+
+MAKEFILE = (ROOT / "Makefile").read_text(encoding="utf-8")
+COMMANDS = gates.gate_commands(MAKEFILE)
+
+
+class MakefileGatesTest(unittest.TestCase):
+    def test_shared_block_holds_the_research_gates_once(self):
+        self.assertGreaterEqual(len(COMMANDS), 30)
+        self.assertEqual(len(COMMANDS), len(set(COMMANDS)))
+        for target in gates.GATE_TARGETS:
+            recipe = gates.target_recipe(MAKEFILE, target)
+            self.assertEqual([], [command for command in COMMANDS if command in recipe], target)
+
+    def test_every_gate_target_runs_every_gate_command(self):
+        for command in COMMANDS:
+            self.assertTrue(gates.runs_in_every_gate_target(MAKEFILE, command), command)
+
+    def test_target_that_drops_the_block_is_rejected(self):
+        broken = MAKEFILE.replace("health-fast:\n\tpython tools/repo_health_check.py --fast\n\t$(research-gates)\n", "health-fast:\n\tpython tools/repo_health_check.py --fast\n")
+        self.assertNotEqual(MAKEFILE, broken)
+        self.assertFalse(gates.runs_in_every_gate_target(broken, COMMANDS[0]))
+
+    def test_command_removed_from_block_is_rejected(self):
+        broken = MAKEFILE.replace("python tools/check_s_core_w4.py\n", "", 1)
+        self.assertFalse(gates.runs_in_every_gate_target(broken, "python tools/check_s_core_w4.py"))
+
+    def test_missing_block_yields_no_commands(self):
+        self.assertEqual([], gates.gate_commands("health:\n\tpython tools/x.py\n"))
+
+    @unittest.skipUnless(shutil.which("make"), "make is not installed")
+    def test_make_expands_the_block_in_every_gate_target(self):
+        for target in gates.GATE_TARGETS:
+            planned = subprocess.run(["make", "-n", target], cwd=ROOT, capture_output=True, text=True, check=True).stdout.splitlines()
+            for command in COMMANDS:
+                self.assertIn(command, planned, (target, command))
+
+
+if __name__ == "__main__":
+    unittest.main()
