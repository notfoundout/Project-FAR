  "default_rule": "unregistered artifacts have no authority beyond their explicit local status and content",
  "domains": {
    "authority_model_specification": {
      "owner": "docs/governance/evidence-authority-model.md",
      "current_status": "Research",
      "required_status_for_activation": "Accepted",
      "authority_class": "canonical_specification",
      "proposition_scope": "evidence authority classes priority rules activation conditions and claim boundaries",
      "may_establish": ["authority classes", "priority rules", "activation conditions", "claim boundaries after valid activation"],
      "may_not_establish": ["self-acceptance", "self-promotion", "theorem truth", "empirical truth"]
    },
    "authority_registry_specification": {
      "owner": "docs/governance/evidence-authority-registry.json",
      "current_status": "Research",
      "required_status_for_activation": "Accepted",
      "authority_class": "canonical_specification",
      "proposition_scope": "registered authority owners scopes permitted statuses and activation requirements",
      "may_establish": ["registered owner mapping", "registered scope mapping", "permitted status mapping after valid activation"],
      "may_not_establish": ["self-acceptance", "self-promotion", "artifact truth", "proof truth"]
    },
    "governance_decisions": {
      "proposed_owner": "docs/DECISION_LOG.md",
      "owner_state": "candidate_inactive_until_external_bootstrap",
      "authority_class": "governance_decision",
