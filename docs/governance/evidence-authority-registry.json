    "proof_records": {
      "owner_pattern": "foundations/**/proof*.md|theory/**/proof*.md|theory/proofs/**|theory/**/proofs/**|theory/evaluation/*.json|theory/proof-objects/*.proof.yaml|docs/governance/proofs/**|docs/research/*proof*.md|mechanization/lean/*.lean",
