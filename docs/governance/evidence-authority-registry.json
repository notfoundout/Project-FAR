{
  "schema_version": "1.6",
  "status": "Research",
  "candidacy": "inactive_candidate",
  "promotion_completed": false,
  "authority_model": "docs/governance/evidence-authority-model.md",
  "lifecycle_state": "Research",
  "active": false,
  "self_activation_prohibited": true,
  "artifact_status_taxonomy": ["Accepted", "Research", "Provisional", "Archive", "Unknown"],
  "bootstrap": {
    "status": "Unknown",
    "required_authority": "an Accepted-status or promotion-provenance authority whose authority predates this model",
    "selected_owner": null,
    "selection_must_be_preregistered_and_hash_locked": true
  },
  "permitted_statuses_by_class": {
    "governance_decision": ["Accepted"],
    "canonical_specification": ["Accepted"],
    "proof_record": ["Accepted"],
    "status_register": ["Accepted"],
    "research_record": ["Research", "Accepted"],
    "methodological_specification": ["Accepted"],
    "index": ["Accepted"],
    "historical_record": ["Archive"]
  },
  "activation_requirements": [
    "independent bootstrap authority selected and hash locked",
    "every fixed canonical owner has an explicit artifact status",
    "every fixed canonical owner requiring active authority has status Accepted",
    "proof owner pattern covers every proof object named by registered proof metadata"
  ],
  "default_rule": "unregistered artifacts have no authority beyond their explicit local status and content",
  "domains": {
    "governance_decisions": {
      "proposed_owner": "docs/DECISION_LOG.md",
      "owner_state": "candidate_inactive_until_external_bootstrap",
      "authority_class": "governance_decision",
      "proposition_scope": "acceptance promotion deprecation scope ownership and change-control decisions",
      "may_establish": ["acceptance", "promotion", "deprecation", "scope", "ownership", "change control"],
      "may_not_establish": ["theorem truth", "empirical truth", "self-acceptance", "self-promotion"]
    },
    "repository_navigation": {
      "owner": "docs/CANONICAL_MAP.md",
      "authority_class": "index",
      "proposition_scope": "canonical artifact routing only",
      "may_establish": ["canonical artifact location"],
      "may_not_establish": ["claim truth", "proof", "acceptance", "empirical result"]
    },
    "framework_boundaries": {
      "owner": "docs/governance/framework-boundaries.md",
      "authority_class": "canonical_specification",
      "proposition_scope": "framework ownership boundaries and allowed dependency directions",
      "may_establish": ["framework ownership", "allowed dependency direction", "framework nonclaims"],
      "may_not_establish": ["logical derivation", "necessity", "minimality", "universality"]
    },
    "theorem_and_proof_status": {
      "owner": "docs/governance/theorem-proof-status-register.md",
      "authority_class": "status_register",
      "proposition_scope": "theorem classification and proof-assurance classification",
      "may_establish": ["theorem classification", "proof assurance classification", "registered scope"],
      "may_not_establish": ["truth without linked proof record", "scope expansion"]
    },
    "proof_records": {
      "owner_pattern": "foundations/**/proof*.md|theory/**/proof*.md|theory/**/proofs/**|theory/evaluation/*.json|docs/governance/proofs/**|docs/research/*proof*.md|mechanization/lean/*.lean",
      "authority_class": "proof_record",
      "proposition_scope": "exact registered formal statements under explicit premises",
      "requires": ["statement identifier", "exact statement", "premises", "scope", "model class", "proof object", "status-register entry"],
      "may_establish": ["exact proved statement under registered premises"],
      "may_not_establish": ["unregistered theorem truth", "scope expansion", "empirical truth"]
    },
    "claim_status": {
      "owner": "docs/governance/claim-status-matrix.md",
      "authority_class": "status_register",
      "proposition_scope": "epistemic claim classifications",
      "may_establish": ["epistemic classification", "known limitation linkage"],
      "may_not_establish": ["claim truth", "proof"]
    },
    "derivation_status": {
      "owner": "docs/governance/derivation-status-matrix.md",
      "authority_class": "status_register",
      "proposition_scope": "derived methodological and governance dependency classifications",
      "may_establish": ["derived versus methodological versus governance classification"],
      "may_not_establish": ["derivation without proof record", "theorem truth"]
    },
    "canonical_terminology": {
      "owner": "docs/glossary/canonical-terminology.md",
      "authority_class": "canonical_specification",
      "proposition_scope": "canonical names and short declared meanings",
      "may_establish": ["canonical names", "short declared meanings", "framework ownership of terms"],
      "may_not_establish": ["detailed formal definitions", "necessity", "minimality", "empirical adequacy"]
    },
    "detailed_definitions": {
      "owner": "theory/definitions/definitions.md",
      "current_status": "Unknown",
      "required_status_for_activation": "Accepted",
      "authority_class": "canonical_specification",
      "proposition_scope": "detailed formal definitions",
      "may_establish": ["detailed formal definitions within stated scope"],
      "may_not_establish": ["canonical naming overrides", "necessity", "minimality", "empirical adequacy"]
    },
    "research_observations": {
      "owner_pattern": "research/**/result*.json|research/**/report*.md|research/**/evidence/**",
      "authority_class": "research_record",
      "proposition_scope": "bounded observations from registered designs",
      "requires": ["question", "execution specification", "source identity", "result", "nonclaims"],
      "may_establish": ["bounded observation", "registered counterexample", "failure report"],
      "may_not_establish": ["canonical theory", "acceptance", "promotion", "global generalization"]
    },
    "methodology": {
      "owner_pattern": "frameworks/FAR/**|methodology/**",
      "authority_class": "methodological_specification",
      "proposition_scope": "adopted investigation and evaluation procedures",
      "may_establish": ["adopted investigation procedure", "evaluation rule"],
      "may_not_establish": ["logical derivation from FARA", "truth of investigated claim"]
    },
    "historical_records": {
      "owner_pattern": "archive/**",
      "authority_class": "historical_record",
      "proposition_scope": "artifact provenance and superseded reasoning",
      "may_establish": ["provenance", "superseded reasoning"],
      "may_not_establish": ["active canonical authority", "claim truth", "acceptance", "promotion"]
    }
  },
  "promotion_requirements": [
    "separate preregistered lifecycle",
    "pre-existing independent bootstrap authority",
    "bootstrap authority hash lock",
    "exact artifact and version",
    "promoted propositions and scope",
    "required proof or evidence",
    "replication record",
    "acceptance record",
    "promotion record",
    "owner status transitions completed",
    "limitations and counterexamples",
    "status-register update",
    "canonical-map update",
    "semantic and dependency validation"
  ],
  "forbidden_inferences": [
    "location implies authority",
    "CI success implies truth",
    "formal notation implies proof",
    "repetition implies corroboration",
    "index entry implies acceptance",
    "research result directly rewrites canonical theory",
    "artifact self-promotion",
    "candidate owner implies active owner",
    "authority model self-acceptance",
    "authority registry self-promotion",
    "research candidate implies acceptance",
    "research candidate authorizes experiment execution",
    "research candidate prohibits experiment execution",
    "lifecycle promotion implies artifact status Promoted"
  ]
}
